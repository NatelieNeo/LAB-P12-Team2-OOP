# Copy to .env and fill in keys locally. Never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLAUDE_MODEL=claude-sonnet-5-5
# gemini | claude | multi. Leaving this blank selects multi when both keys exist.
AI_MODE=multi
CALORA_STORAGE=sqlite
AI_REQUEST_TIMEOUT_SECONDS=45
# Claude returns a large ten-meal JSON response; allow more time per attempt.
CLAUDE_REQUEST_TIMEOUT_SECONDS=120
# Covers three Claude attempts, retry delays, and one Gemini backup request.
AI_TOTAL_TIMEOUT_SECONDS=450
CLAUDE_GEMINI_BACKUP=1
# Blank reuses GEMINI_MODEL with an independent client/request in Claude's worker slot.
GEMINI_BACKUP_MODEL=
AI_MAX_OUTPUT_TOKENS=8192
CLAUDE_MAX_OUTPUT_TOKENS=16384
FLASK_SECRET_KEY=replace-with-a-random-local-secret
# Only applies to the legacy Gemini race when AI_MODE is blank and only Gemini is configured.
CALORA_PARALLEL_AI=0
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
