# Copy to .env and fill in keys locally. Never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLAUDE_MODEL=claude-sonnet-5-5
# gemini | claude | multi. Leaving this blank selects multi when both keys exist.
AI_MODE=multi
AI_REQUEST_TIMEOUT_SECONDS=45
AI_TOTAL_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=8192
FLASK_SECRET_KEY=replace-with-a-random-local-secret
# Only applies to the legacy Gemini race when AI_MODE is blank and only Gemini is configured.
CALORA_PARALLEL_AI=0
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
